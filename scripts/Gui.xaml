<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Toolkit" Height="640" Width="820"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral -->
        <StackPanel Grid.Column="0" Background="#181825">
            <TextBlock Text="PC TOOLKIT" Foreground="#89B4FA" FontSize="20" FontWeight="Bold" Margin="16,16,0,2"/>
            <TextBlock Text="Diagnostico y optimizacion" Foreground="#6C7086" FontSize="11" Margin="16,0,0,12"/>

            <Button x:Name="BtnHealth"   Content="Chequeo de salud"  Height="40" Margin="12,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            <Button x:Name="BtnClean"    Content="Limpiar caches"    Height="40" Margin="12,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            <Button x:Name="BtnOptimize" Content="Optimizar gaming"  Height="40" Margin="12,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            <Button x:Name="BtnMonitor"  Content="Monitorear GPU"    Height="40" Margin="12,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            <Button x:Name="BtnBench"    Content="Benchmark"         Height="40" Margin="12,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>

            <TextBlock Text="Juego (para optimizar):" Foreground="#6C7086" FontSize="11" Margin="16,14,0,4"/>
            <TextBox x:Name="TxtGamePath" Height="26" Margin="12,0" Background="#11111B" Foreground="#CDD6F4" BorderBrush="#45475A"/>
            <Button x:Name="BtnBrowse" Content="Buscar ejecutable..." Height="30" Margin="12,6" Background="#45475A" Foreground="#CDD6F4" BorderThickness="0"/>

            <TextBlock Text="v1.1 - MIT" Foreground="#585B70" FontSize="10" Margin="16,20,0,0"/>
        </StackPanel>

        <!-- Panel derecho -->
        <DockPanel Grid.Column="1" Margin="8">
            <Border DockPanel.Dock="Top" Background="#313244" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                <TextBlock x:Name="TxtStatus" Text="Listo." Foreground="#A6E3A1" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#11111B" CornerRadius="4" Padding="8">
                <TextBox x:Name="TxtOutput" IsReadOnly="True" Background="Transparent" Foreground="#CDD6F4"
                         FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" BorderThickness="0"
                         Text="Consola de salida. Elegi una herramienta de la izquierda.`n"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
